generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  timelines     Timeline[]
  /// Guest accounts are deleted after 30 days without activity.
  isGuest       Boolean   @default(false)
  /// Updated at most once a day while the user is active.
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isGuest, lastActiveAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── NeeLine custom models ───────────────────────────────────────

model Timeline {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  deletedAt   DateTime?

  /// Canvas colours. Null means "follow the app theme"; the app always writes
  /// these explicitly. The column defaults are the old values, kept so the
  /// previous release keeps working while the migration rolls out.
  bgColor     String?   @default("#0a1628")
  spineColor  String?   @default("#c9a84c")
  tickColor   String?   @default("#c9a84c")
  textColor   String?   @default("#f5f0e8")

  events      Event[]
  layers      Layer[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
}

model Layer {
  id         String   @id @default(cuid())
  timelineId String
  name       String
  /// Lower-cased, trimmed name; layer names are unique per timeline ignoring case.
  nameKey    String
  color      String
  position   Int
  visible    Boolean  @default(true)
  /// The "General" layer every timeline has; it cannot be renamed or deleted.
  isDefault  Boolean  @default(false)

  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  events     Event[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([timelineId, nameKey])
  @@index([timelineId, position])
}

model Event {
  id                String   @id @default(cuid())
  timelineId        String
  /// Null is treated as the timeline's default layer.
  layerId           String?
  year              Int
  isBce             Boolean  @default(false)
  month             Int?
  day               Int?
  /// Present only for periods (spans).
  endYear           Int?
  endIsBce          Boolean?
  endMonth          Int?
  endDay            Int?
  title             String
  /// Plain-text notes.
  description       String?
  /// The original description with its embedded metadata tag, kept until the
  /// metadata migration is confirmed. Never written by the app.
  legacyDescription String?
  color             String   @default("#c9a84c")

  timeline          Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  layer             Layer?   @relation(fields: [layerId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([timelineId])
  @@index([timelineId, year])
  @@index([timelineId, createdAt])
  @@index([layerId])
}

/// Fixed-window request counters for rate limiting.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

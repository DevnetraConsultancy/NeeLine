# Copy this file to .env (local) and fill in real values.
# Never commit .env. On Vercel, set these under Project Settings > Environment Variables.

# PostgreSQL connection string (Neon, Supabase or any Postgres 14+).
# Local development without Postgres installed: run `npm run db:local` and use
# postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Random secret, at least 32 characters. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (optional locally; the Google button is hidden when unset).
# Authorised redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only needed when running a production build outside Vercel (for example `npm start` locally).
# AUTH_TRUST_HOST="true"
